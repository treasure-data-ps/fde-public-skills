_export: 
  !include : 'config.yml'
  td:
    database: ${sink_database}

  current_session: ${moment(session_time).format("YYYYMMDDHH")}
  predict_start_date: ${moment(session_time).subtract(3, 'months').format('YYYY-MM-DD')}
  predict_end_date: ${moment(session_time).subtract(1, 'days').format('YYYY-MM-DD')}
  train_start_date: ${moment(session_time).subtract(15, 'months').format('YYYY-MM-DD')}
  train_end_date: ${moment(session_time).subtract(3, 'months').subtract(1, 'days').format('YYYY-MM-DD')}
  
# ============================================================
# DATA PREP
# ============================================================
# Add customer-specific data prep steps here for train and pred.
# See train.dig and predict.dig for
# the full workflow structure.
#
# +create_union_src_tables:
#   call>: data_prep.dig