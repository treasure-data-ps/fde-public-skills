_export:
  !include : config.yml
  td:
    database: ${sink_database}

  current_session: ${moment(session_time).format("YYYYMMDDHH")}
  predict_end_date: ${moment(session_time).subtract(1, 'days').format('YYYY-MM-DD')}
  # For base table rebuilds (need enough history for 12m feature lookback)
  predict_start_date: ${moment(session_time).subtract(look_back_months_prediction, 'months').format('YYYY-MM-DD')}
  mode: 'pred'




# ============================================================
# DATA PREP FOR PREDICTION
# ============================================================
# Add customer-specific data prep steps here.
# These steps should create the following tables:
#
#   1. Base input tables - source data joined/filtered for
#      prediction (e.g., leads_data_pred with user_id,
#      reference_date, and raw features — no target variable)
#
#   2. Feature tables - call the shared data prep workflow:
#      call>: data_prep.dig
#
#   3. Final features table - join all feature tables into
#      a single prediction dataset:
#      create_table: lead_final_features_${mode}
#
# Example:
#   +create_input_table:
#     td>: sql/your_prediction_base.sql
#     create_table: leads_data_pred
#
#   +create_feature_tables:
#     call>: data_prep.dig
#
#   +create_final_features_table:
#     td>: sql/your_final_features.sql
#     create_table: lead_final_features_${mode}
# ============================================================

+get_latest_batch:
  td>: queries/get_latest_batchids.sql
  store_last_results: true

+run_prediction:
  docker:
    image: "digdag/digdag-python:3.9.22-td2"
  py>: python.predict_main.main
  _env:
    apikey: ${secret:apikey}
    database: ${sink_database}
    train_session_id: ${td.last_results.train_session_id}
    train_batch_id:   ${td.last_results.train_batch_id}
    pred_session_id:  ${td.last_results.pred_session_id}
    pred_batch_id:    ${td.last_results.pred_batch_id}
    MODE: predict

    prediction_table: ${table_prefix}final_features_${mode}
    trgt_table:       ${table_prefix}predictions
    description:      ${description}

    # ══════════════════════════════════════════════════════════════
    # MODEL SELECTION  — must match the model_type used at training
    # ══════════════════════════════════════════════════════════════
    # logistic | xgboost | catboost
    # Drives:
    #   - Where the model is loaded from (coefficients table vs. td-model-store)
    #   - Whether features are scaled (logistic only)
    #   - Whether NaN is imputed (logistic only) or passed through to model
    #   - Which SHAP explainer is used (LinearExplainer vs. TreeExplainer)
    model_type: ${model_type}
    model_store_table: ${model_store_table}
    model_name: ${model_name}
    td_endpoint: ${td_endpoint}

    # ══════════════════════════════════════════════════════════════
    # LEAD IDENTITY
    # ══════════════════════════════════════════════════════════════
    # Column in the prediction feature table that uniquely identifies
    # a lead (ucp_id / lead_id / customer_id).  This becomes the
    # user_id column on every output table — it's the join key Sales
    # uses to attribute scores back to real people.
    #
    # Auto-added to columns_to_drop so it can never leak into the model.
    user_id_col: ${user_id_col}

    # ══════════════════════════════════════════════════════════════
    # FEATURE-LEVEL DROP LIST
    # MUST mirror the training Digdag's columns_to_drop exactly so the
    # preprocessor produces the same one-hot column set.
    # ══════════════════════════════════════════════════════════════
    columns_to_drop: >-
      batch_id,description,reference_date,ucp_id,RPOS_product,
      approved_app_conversion,booked_app_conversion,session_id,
      product_latest,time

    # ── Output table prefix ──────────────────────────────────────
    table_prefix: ${table_prefix}

    # ══════════════════════════════════════════════════════════════
    # SHAP — per-row top drivers
    # ══════════════════════════════════════════════════════════════
    # For each scored lead, write the top-N features that pushed the
    # score UP and the top-N that pushed it DOWN to:
    #   lead_scoring_prediction_shap
    #
    # Output is long-format: (pred_session_id, user_id, feature_name,
    # feature_value, shap_value, direction, rank_within_direction).
    #
    # Cost note: TreeExplainer scales linearly in n_samples × n_trees.
    # For 500K leads × 80 features × 500 trees, expect ~30s.  If your
    # population is much larger, set shap_max_rows to a representative
    # sample (e.g. 100000) — scoring still covers every lead, but SHAP
    # is computed on a uniform sample.
    shap_topn_per_direction: '5'
    shap_max_rows:           '0'      # 0 = SHAP for every lead

    # ══════════════════════════════════════════════════════════════
    # PARALLEL TD WRITES
    # ══════════════════════════════════════════════════════════════
    # 4 output tables get flushed concurrently at the end:
    #   trgt_table, prediction_shap, prediction_bins, prediction_run_log
    write_concurrency: '4'

    unit: ''
